CONFIG_ESP_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_ESP_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_MQTT_BROKER_URI="mqtt://broker.hivemq.com"
CONFIG_RELAY1_GPIO=18
CONFIG_RELAY2_GPIO=19
CONFIG_RELAY3_GPIO=22
CONFIG_RELAY4_GPIO=23
CONFIG_RELAY_ACTIVE_HIGH=n
CONFIG_MQTT_TOPIC_BASE="esp32/relay"
CONFIG_HEARTBEAT_INTERVAL_SEC=10
